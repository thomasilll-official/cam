// ==========================================
// LIVE CAMERA STREAM
// ==========================================

void handleStream() {

  WiFiClient client = server.client();

  client.print(
    "HTTP/1.1 200 OK\r\n"
    "Content-Type: multipart/x-mixed-replace; boundary=frame\r\n"
    "Cache-Control: no-cache\r\n"
    "Connection: close\r\n\r\n"
  );

  Serial.println("Camera client connected");

  while (client.connected()) {

    camera_fb_t *fb = esp_camera_fb_get();

    if (fb == NULL) {
      Serial.println("Camera capture failed");
      delay(100);
      continue;
    }

    if (fb->format != PIXFORMAT_JPEG) {
      esp_camera_fb_return(fb);
      continue;
    }

    client.printf(
      "--frame\r\n"
      "Content-Type: image/jpeg\r\n"
      "Content-Length: %u\r\n\r\n",
      (unsigned int)fb->len
    );

    size_t written = client.write(fb->buf, fb->len);

    client.print("\r\n");

    esp_camera_fb_return(fb);

    if (written != fb->len) {
      break;
    }

    delay(20);
  }

  client.stop();

  Serial.println("Camera client disconnected");
}

// ==========================================
// WIFI AP + STATION MODE
// ==========================================

void startWiFi() {

  WiFi.mode(WIFI_AP_STA);
  WiFi.setSleep(false);

  // Start ESP32 hotspot

  WiFi.softAPConfig(
    IPAddress(192, 168, 4, 1),
    IPAddress(192, 168, 4, 1),
    IPAddress(255, 255, 255, 0)
  );

  if (WiFi.softAP(AP_SSID, AP_PASSWORD)) {

    Serial.println("ESP32 HOTSPOT STARTED");

    Serial.print("AP IP: ");
    Serial.println(WiFi.softAPIP());

  } else {

    Serial.println("HOTSPOT FAILED");
  }

  // Connect to Airtel router

  Serial.println("Connecting to Airtel WiFi...");

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int timeout = 0;

  while (WiFi.status() != WL_CONNECTED && timeout < 30) {
    delay(500);
    Serial.print(".");
    timeout++;
  }

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("\nAIRTEL WIFI CONNECTED");

    Serial.print("Router IP: ");
    Serial.println(WiFi.localIP());

  } else {

    Serial.println("\nAIRTEL WIFI NOT CONNECTED");
    Serial.println("ESP32 HOTSPOT IS STILL AVAILABLE");
  }
}

// ==========================================
// SETUP
// ==========================================

void setup() {

  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("FREENOVE ESP32-S3 CAMERA");
  Serial.println("DUAL WIFI MODE");
  Serial.println("================================");

  cameraReady = startCamera();

  if (!cameraReady) {
    Serial.println("CAMERA ERROR - CHECK HARDWARE");
    return;
  }

  startWiFi();

  // Start web server

  server.on("/", HTTP_GET, handleRoot);
  server.on("/stream", HTTP_GET, handleStream);

  server.begin();

  Serial.println();
  Serial.println("================================");
  Serial.println("CAMERA SERVER READY");
  Serial.println("AP URL: http://192.168.4.1");

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("AIRTEL URL: http://");
    Serial.println(WiFi.localIP());
  }

  Serial.println("================================");
}

// ==========================================
// MAIN LOOP
// ==========================================

void loop() {

  if (cameraReady) {
    server.handleClient();
  }

  delay(2);
}

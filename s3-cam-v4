  WiFi.setSleep(false);

  WiFi.softAPConfig(
    IPAddress(192, 168, 4, 1),
    IPAddress(192, 168, 4, 1),
    IPAddress(255, 255, 255, 0)
  );

  if(WiFi.softAP(AP_SSID, AP_PASSWORD)) {

    Serial.println("HOTSPOT STARTED");

    Serial.print("AP IP: ");
    Serial.println(WiFi.softAPIP());
  }

  Serial.println("Connecting to Airtel...");

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int timeout = 0;

  while(
    WiFi.status() != WL_CONNECTED &&
    timeout < 30
  ) {

    delay(500);
    Serial.print(".");

    timeout++;
  }

  if(WiFi.status() == WL_CONNECTED) {

    Serial.println("\nAIRTEL CONNECTED");

    Serial.print("Airtel IP: ");
    Serial.println(WiFi.localIP());

  } else {

    Serial.println("\nAirtel connection failed.");
    Serial.println("Hotspot still available.");
  }
}

// =================================================
// SETUP
// =================================================

void setup() {

  Serial.begin(115200);

  pinMode(FLASH_LED_GPIO, OUTPUT);
  digitalWrite(FLASH_LED_GPIO, LOW);
  flashLedOn = false;

  delay(1000);

  loadPersistentSettings();

  Serial.println();
  Serial.println("================================");
  Serial.println("ESP32-S3 CAMERA CONTROL");
  Serial.println("================================");

  cameraReady = startCamera();

  if(!cameraReady) {

    Serial.println("CAMERA ERROR!");
    return;
  }

  if (!applyPersistentCameraSettings()) {
    Serial.println("Warning: some saved camera settings were not supported.");
  }

  sdReady = startSDCard();

  if(!sdReady) {

    Serial.println("SD CARD ERROR!");
    Serial.println("Check card and SD pins.");
  }

  startWiFi();

  // WEB ROUTES

  server.on("/", HTTP_GET, handleRoot);

  server.on("/preview", HTTP_GET, handlePreview);

  server.on("/api/flash", HTTP_GET, handleFlashControl);

  server.on("/api/camera/settings", HTTP_GET, handleCameraSettings);

  server.on("/api/settings", HTTP_GET, handleSavedSettings);

  server.on("/api/cctv", HTTP_GET, handleCCTVToggle);

  server.on("/api/cctv/status", HTTP_GET, handleCCTVStatus);

  server.on("/api/photo", HTTP_GET, handlePhoto);

  server.on("/api/record/start", HTTP_GET, handleRecordStart);

  server.on("/api/record/stop", HTTP_GET, handleRecordStop);

  server.on("/api/files", HTTP_GET, handleGallery);

  server.on("/api/storage", HTTP_GET, handleStorage);

  server.on("/file", HTTP_GET, handleFile);

  server.on("/api/delete", HTTP_GET, handleDelete);

  server.on("/api/delete-all", HTTP_GET, handleDeleteAll);

  server.begin();

  // The saved CCTV state is kept in NVS. loop() will start recording
  // automatically and retry if camera/SD initialization is temporarily busy.
  if (cctvEnabled) {
    Serial.println("Saved CCTV mode is ON. Automatic recording is pending...");
    lastCCTVRetryTime = 0;
  } else {
    Serial.println("Saved CCTV mode is OFF.");
  }

  Serial.println();
  Serial.println("================================");
  Serial.println("CAMERA PRO READY");

  Serial.println("AP URL:");
  Serial.println("http://192.168.4.1");

  if(WiFi.status() == WL_CONNECTED) {

    Serial.print("AIRTEL URL: http://");
    Serial.println(WiFi.localIP());
  }

  Serial.println("================================");
}

// =================================================
// MAIN LOOP
// =================================================

void loop() {

  server.handleClient();

  // If CCTV was ON before power loss, keep trying until recording starts.
  // The NVS flag remains ON through power cycles and temporary SD failures.
  if (cctvEnabled && !recording && cameraReady && sdReady) {
    uint32_t now = millis();
    if (lastCCTVRetryTime == 0 ||
        (uint32_t)(now - lastCCTVRetryTime) >= CCTV_RETRY_INTERVAL) {
      lastCCTVRetryTime = now;
      Serial.println("CCTV is enabled; attempting to start recording...");
      if (!startRecording()) {
        Serial.println("CCTV start attempt failed; will retry.");
      }
    }
  }

  // RECORD VIDEO FRAMES

  if(recording) {

    camera_fb_t *fb = esp_camera_fb_get();

    if(fb) {

      writeAviFrame(fb);

      esp_camera_fb_return(fb);

      // If a video segment reaches its frame limit, loop() will start
      // the next segment automatically while cctvEnabled remains true.

    } else {

      Serial.println("Frame capture failed");
    }

    delay(100);
  }

  delay(2);
}

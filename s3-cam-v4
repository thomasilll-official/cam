void handleCCTVToggle() {
  if (!server.hasArg("state")) {
    server.send(400, "text/plain", "Missing state");
    return;
  }
  String state = server.arg("state");

  if (state == "on") {
    // Save the requested CCTV state FIRST. If startup is temporarily
    // impossible (SD/camera busy), loop() will keep retrying automatically.
    cctvEnabled = true;
    preferences.begin("camera", false);
    preferences.putBool("cctv", true);
    preferences.end();

    if (!recording) {
      if (startRecording()) {
        server.send(200, "text/plain", "CCTV mode ON. Recording is active.");
      } else {
        server.send(200, "text/plain", "CCTV mode ON. Recording will start automatically when the camera and SD card are ready.");
      }
    } else {
      server.send(200, "text/plain", "CCTV mode ON. Recording is already active.");
    }
    return;

  } else if (state == "off") {
    // OFF is the only user command that disables automatic CCTV recording.
    cctvEnabled = false;
    preferences.begin("camera", false);
    preferences.putBool("cctv", false);
    preferences.end();

    if (recording) stopRecording();

    server.send(200, "text/plain", "CCTV mode OFF. Recording stopped and OFF state saved.");
    return;

  } else {
    server.send(400, "text/plain", "State must be on or off");
    return;
  }
}

// =================================================
// CAMERA SETTINGS API
// =================================================

// Apply a setting to the active camera sensor.
// Resolution changes are blocked while recording so AVI dimensions stay correct.
void handleCameraSettings() {
  if (!cameraReady) {
    server.send(503, "text/plain", "Camera unavailable");
    return;
  }

  if (recording) {
    server.send(409, "text/plain", "Stop recording before changing camera settings");
    return;
  }

  sensor_t *sensor = esp_camera_sensor_get();
  if (sensor == NULL) {
    server.send(500, "text/plain", "Camera sensor unavailable");
    return;
  }

  bool ok = true;

  if (server.hasArg("resolution")) {
    String resolution = server.arg("resolution");
    framesize_t frameSize;

    if      (resolution == "QQVGA") frameSize = FRAMESIZE_QQVGA;
    else if (resolution == "QVGA")  frameSize = FRAMESIZE_QVGA;
    else if (resolution == "VGA")   frameSize = FRAMESIZE_VGA;
    else if (resolution == "SVGA")  frameSize = FRAMESIZE_SVGA;
    else if (resolution == "XGA")   frameSize = FRAMESIZE_XGA;
    else if (resolution == "HD")    frameSize = FRAMESIZE_HD;
    else if (resolution == "SXGA")  frameSize = FRAMESIZE_SXGA;
    else if (resolution == "UXGA")  frameSize = FRAMESIZE_UXGA;
    else {
      server.send(400, "text/plain", "Unsupported resolution");
      return;
    }

    if (sensor->set_framesize(sensor, frameSize) != 0) ok = false;
    delay(150);
  }

  if (server.hasArg("brightness")) {
    int v = constrain(server.arg("brightness").toInt(), -2, 2);
    if (sensor->set_brightness(sensor, v) != 0) ok = false;
  }

  if (server.hasArg("contrast")) {
    int v = constrain(server.arg("contrast").toInt(), -2, 2);
    if (sensor->set_contrast(sensor, v) != 0) ok = false;
  }

  if (server.hasArg("saturation")) {
    int v = constrain(server.arg("saturation").toInt(), -2, 2);
    if (sensor->set_saturation(sensor, v) != 0) ok = false;
  }

  if (server.hasArg("sharpness")) {
    int v = constrain(server.arg("sharpness").toInt(), -2, 2);
    if (sensor->set_sharpness(sensor, v) != 0) ok = false;
  }

  if (server.hasArg("quality")) {
    int v = constrain(server.arg("quality").toInt(), 10, 63);
    if (sensor->set_quality(sensor, v) != 0) ok = false;
  }

  if (server.hasArg("hmirror")) {
    int v = server.arg("hmirror").toInt() ? 1 : 0;
    if (sensor->set_hmirror(sensor, v) != 0) ok = false;
  }

  if (server.hasArg("vflip")) {
    int v = server.arg("vflip").toInt() ? 1 : 0;
    if (sensor->set_vflip(sensor, v) != 0) ok = false;
  }

  if (ok) {
    // Save exactly the settings accepted by the UI so they survive power loss.
    if (server.hasArg("resolution")) savedResolution = server.arg("resolution");
    if (server.hasArg("quality")) savedQuality = constrain(server.arg("quality").toInt(), 10, 63);
    if (server.hasArg("brightness")) savedBrightness = constrain(server.arg("brightness").toInt(), -2, 2);
    if (server.hasArg("contrast")) savedContrast = constrain(server.arg("contrast").toInt(), -2, 2);
    if (server.hasArg("saturation")) savedSaturation = constrain(server.arg("saturation").toInt(), -2, 2);
    if (server.hasArg("sharpness")) savedSharpness = constrain(server.arg("sharpness").toInt(), -2, 2);
    if (server.hasArg("hmirror")) savedHmirror = server.arg("hmirror").toInt() ? 1 : 0;
    if (server.hasArg("vflip")) savedVflip = server.arg("vflip").toInt() ? 1 : 0;
    savePersistentSettings();
    server.send(200, "text/plain", "Camera settings applied and saved permanently");
  } else {
    server.send(500, "text/plain", "One or more settings are not supported by this camera sensor");
  }
}

// =================================================
// FLASH LED CONTROL
// =================================================

void handleFlashControl() {
  if (!server.hasArg("state")) {
    server.send(400, "text/plain", "Missing state argument");
    return;
  }

  String state = server.arg("state");
  if (state != "on" && state != "off") {
    server.send(400, "text/plain", "State must be on or off");
    return;
  }

  flashLedOn = (state == "on");
  digitalWrite(FLASH_LED_GPIO, flashLedOn ? HIGH : LOW);
  server.send(200, "text/plain", flashLedOn ? "Flashlight is ON" : "Flashlight is OFF");
}

// =================================================
// PHOTO CAPTURE
// =================================================

void handlePhoto() {

  if (!cameraReady || !sdReady) {
    server.send(500, "text/plain", "Camera or SD unavailable");
    return;
  }

  if (recording) {
    server.send(409, "text/plain", "Stop recording before taking a photo");
    return;
  }

  camera_fb_t *fb = esp_camera_fb_get();

  if (!fb) {
    server.send(500, "text/plain", "Camera capture failed");
    return;
  }

  String path =
    "/photos/PHOTO_" + String(millis()) + ".jpg";

  File file = SD_MMC.open(path, FILE_WRITE);

  if (!file) {

    esp_camera_fb_return(fb);

    server.send(500, "text/plain", "Cannot save photo");
    return;
  }

  size_t written = file.write(fb->buf, fb->len);

  file.close();

  esp_camera_fb_return(fb);

  if (written == 0) {
    server.send(500, "text/plain", "Photo save failed");
    return;
  }

  Serial.print("PHOTO SAVED: ");
  Serial.println(path);

  server.send(200, "text/plain", "Photo saved: " + path);
}

// =================================================
// LIVE PREVIEW
// =================================================

void handlePreview() {

  if (!cameraReady) {
    server.send(503, "text/plain", "Camera unavailable");
    return;
  }

  camera_fb_t *fb = esp_camera_fb_get();

  if (!fb) {
    server.send(500, "text/plain", "Capture failed");
    return;
  }

  server.setContentLength(fb->len);
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "image/jpeg", "");

  server.sendContent(
    (const char*)fb->buf,
    fb->len
  );

  esp_camera_fb_return(fb);
}

// =================================================
// START / STOP RECORDING ROUTES
// =================================================

void handleRecordStart() {

  if (recording) {
    server.send(200, "text/plain", "Already recording");
    return;
  }

  if (startRecording()) {
    server.send(200, "text/plain", "Recording started");
  } else {
    server.send(500, "text/plain", "Recording failed");
  }
}

void handleRecordStop() {

  // Persistent CCTV mode must only be stopped with the CCTV ON/OFF button.
  if (cctvEnabled) {
    server.send(409, "text/plain", "CCTV mode is ON. Turn CCTV OFF to stop recording.");
    return;
  }

  if (!recording) {
    server.send(200, "text/plain", "Not recording");
    return;
  }

  stopRecording();
  server.send(200, "text/plain", "Video saved successfully");
}

// =================================================
// SAFE FILE PATH CHECK
// =================================================

bool validMediaPath(String path) {

  if (
    !path.startsWith("/photos/") &&
    !path.startsWith("/videos/")
  ) {
    return false;
  }

  if (
    path.indexOf("..") >= 0 ||
    path.indexOf('\\') >= 0
  ) {
    return false;
  }

  return true;
}

// =================================================
// VIEW / DOWNLOAD FILE
// =================================================

void handleFile() {

  String path = server.arg("name");

  if (!validMediaPath(path)) {
    server.send(400, "text/plain", "Invalid file path");
    return;
  }

  if (recording && path == currentVideoPath) {
    server.send(409, "text/plain", "Video is still recording");
    return;
  }

  if (!SD_MMC.exists(path)) {
    server.send(404, "text/plain", "File not found");
    return;
  }

  File file = SD_MMC.open(path, FILE_READ);

  if (!file) {
    server.send(500, "text/plain", "Cannot open file");
    return;
  }

  if (path.endsWith(".avi")) {

    server.sendHeader(
      "Content-Disposition",
      "attachment; filename=\"" +
      path.substring(path.lastIndexOf('/') + 1) + "\""
    );

    server.streamFile(file, "application/octet-stream");

  } else {

    server.streamFile(file, "image/jpeg");
  }

  file.close();
}

// =================================================
// DELETE SINGLE FILE
// =================================================

void handleDelete() {

  String path = server.arg("name");

  if (!validMediaPath(path)) {
    server.send(400, "text/plain", "Invalid path");
    return;
  }

  if (recording && path == currentVideoPath) {
    server.send(409, "text/plain", "Cannot delete active recording");
    return;
  }

  if (!SD_MMC.exists(path)) {
    server.send(404, "text/plain", "File not found");
    return;
  }

  if (SD_MMC.remove(path)) {

    Serial.print("DELETED: ");
    Serial.println(path);

    server.send(200, "text/plain", "File deleted");

  } else {

    server.send(500, "text/plain", "Delete failed");
  }
}

// =================================================
// COUNT FILES
// =================================================

uint32_t countFiles(const char *directory) {

  File dir = SD_MMC.open(directory);

  if (!dir || !dir.isDirectory()) {
    return 0;
  }

  uint32_t count = 0;

  File file = dir.openNextFile();

  while (file) {

    if (!file.isDirectory()) {
      count++;
    }

    file.close();
    file = dir.openNextFile();
  }

  dir.close();

  return count;
}

// =================================================
// GALLERY API
// =================================================

void appendDirectoryJSON(
  const char *directory,
  const char *type,
  String &json,
  bool &first
) {

  File dir = SD_MMC.open(directory);

  if (!dir || !dir.isDirectory()) {
    return;
  }

  File file = dir.openNextFile();

  while (file) {

    if (!file.isDirectory()) {

      String name = file.name();

      if (!name.startsWith("/")) {
        name = String(directory) + "/" + name;
      }

      if (!first) {
        json += ",";
      }

      first = false;

      json += "{\"name\":\"";
      json += name;
      json += "\",\"type\":\"";
      json += type;
      json += "\",\"size\":";
      json += String(file.size());
      json += "}";
    }

    file.close();
    file = dir.openNextFile();
  }

  dir.close();
}

void handleGallery() {

  String json = "[";
  bool first = true;

  appendDirectoryJSON(
    "/photos", "photo", json, first
  );

  appendDirectoryJSON(
    "/videos", "video", json, first
  );

  json += "]";

  server.send(200, "application/json", json);
}

// =================================================
// STORAGE INFORMATION
// =================================================

void handleStorage() {

  if (!sdReady) {
    server.send(503, "application/json",
                "{\"error\":\"SD card unavailable\"}");
    return;
  }

  uint32_t totalMB =
    (uint32_t)(SD_MMC.totalBytes() / 1048576ULL);

  uint32_t usedMB =
    (uint32_t)(SD_MMC.usedBytes() / 1048576ULL);

  uint32_t freeMB =
    totalMB > usedMB ? totalMB - usedMB : 0;

  String json = "{";

  json += "\"totalMB\":" + String(totalMB) + ",";
  json += "\"usedMB\":" + String(usedMB) + ",";
  json += "\"freeMB\":" + String(freeMB) + ",";

  json += "\"photos\":" +
          String(countFiles("/photos")) + ",";

  json += "\"videos\":" +
          String(countFiles("/videos")) + ",";

  json += "\"recording\":";
  json += recording ? "true" : "false";

  json += "}";

  server.send(200, "application/json", json);
}

// =================================================
// DELETE ALL MEDIA
// =================================================

void deleteDirectoryFiles(const char *directory) {

  File dir = SD_MMC.open(directory);

  if (!dir || !dir.isDirectory()) {
    return;
  }

  File file = dir.openNextFile();

  while (file) {

    String name = file.name();

    if (!name.startsWith("/")) {
      name = String(directory) + "/" + name;
    }

    bool isDirectory = file.isDirectory();

    file.close();

    if (!isDirectory) {

      if (!(recording && name == currentVideoPath)) {
        SD_MMC.remove(name);
      }
    }

    file = dir.openNextFile();
  }

  dir.close();
}

void handleDeleteAll() {

  if (recording) {
    server.send(
      409,
      "text/plain",
      "Stop recording before deleting all files"
    );
    return;
  }

  deleteDirectoryFiles("/photos");
  deleteDirectoryFiles("/videos");

  server.send(200, "text/plain", "All media deleted");
}

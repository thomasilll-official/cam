// =================================================
// AVI FILE HELPERS
// =================================================

void writeFourCC(File &f, const char *s) {
  f.write((const uint8_t*)s, 4);
}

void writeU16(File &f, uint16_t v) {
  uint8_t b[2] = {
    (uint8_t)(v & 0xFF),
    (uint8_t)(v >> 8)
  };
  f.write(b, 2);
}

void writeU32(File &f, uint32_t v) {
  uint8_t b[4] = {
    (uint8_t)(v & 0xFF),
    (uint8_t)(v >> 8),
    (uint8_t)(v >> 16),
    (uint8_t)(v >> 24)
  };
  f.write(b, 4);
}

void patchU32(File &f, uint32_t pos, uint32_t value) {
  uint32_t oldPos = f.position();
  f.seek(pos);
  writeU32(f, value);
  f.seek(oldPos);
}

// =================================================
// CREATE AVI HEADER
// =================================================

void writeAviHeader(uint16_t width, uint16_t height) {

  // RIFF HEADER

  writeFourCC(videoFile, "RIFF");

  riffSizePos = videoFile.position();
  writeU32(videoFile, 0);

  writeFourCC(videoFile, "AVI ");

  // HEADER LIST

  writeFourCC(videoFile, "LIST");

  uint32_t hdrlSizePos = videoFile.position();
  writeU32(videoFile, 0);

  writeFourCC(videoFile, "hdrl");

  // MAIN AVI HEADER

  writeFourCC(videoFile, "avih");
  writeU32(videoFile, 56);

  writeU32(videoFile, 1000000 / VIDEO_FPS);
  writeU32(videoFile, 1000000);
  writeU32(videoFile, 0);
  writeU32(videoFile, 0x10);

  avihFramesPos = videoFile.position();
  writeU32(videoFile, 0);

  writeU32(videoFile, 0);
  writeU32(videoFile, 1);
  writeU32(videoFile, width * height * 2);
  writeU32(videoFile, width);
  writeU32(videoFile, height);

  for (int i = 0; i < 4; i++) {
    writeU32(videoFile, 0);
  }

  // STREAM LIST

  writeFourCC(videoFile, "LIST");

  uint32_t strlSizePos = videoFile.position();
  writeU32(videoFile, 0);

  writeFourCC(videoFile, "strl");

  // STREAM HEADER

  writeFourCC(videoFile, "strh");
  writeU32(videoFile, 56);

  writeFourCC(videoFile, "vids");
  writeFourCC(videoFile, "MJPG");

  writeU32(videoFile, 0);
  writeU16(videoFile, 0);
  writeU16(videoFile, 0);

  writeU32(videoFile, 0);
  writeU32(videoFile, 1);
  writeU32(videoFile, VIDEO_FPS);
  writeU32(videoFile, 0);

  strhFramesPos = videoFile.position();
  writeU32(videoFile, 0);

  writeU32(videoFile, width * height * 2);
  writeU32(videoFile, 0xFFFFFFFF);
  writeU32(videoFile, 0);

  writeU16(videoFile, 0);
  writeU16(videoFile, 0);
  writeU16(videoFile, width);
  writeU16(videoFile, height);

  // BITMAP INFO HEADER

  writeFourCC(videoFile, "strf");
  writeU32(videoFile, 40);

  writeU32(videoFile, 40);
  writeU32(videoFile, width);
  writeU32(videoFile, height);

  writeU16(videoFile, 1);
  writeU16(videoFile, 24);

  writeFourCC(videoFile, "MJPG");

  writeU32(videoFile, width * height * 3);
  writeU32(videoFile, 0);
  writeU32(videoFile, 0);
  writeU32(videoFile, 0);
  writeU32(videoFile, 0);

  // PATCH LIST SIZES

  uint32_t headerEnd = videoFile.position();

  patchU32(
    videoFile,
    strlSizePos,
    headerEnd - (strlSizePos + 4)
  );

  patchU32(
    videoFile,
    hdrlSizePos,
    headerEnd - (hdrlSizePos + 4)
  );

  // MOVIE LIST

  writeFourCC(videoFile, "LIST");

  moviSizePos = videoFile.position();
  writeU32(videoFile, 0);

  writeFourCC(videoFile, "movi");

  moviDataStart = videoFile.position();

  videoFile.flush();
}

// =================================================
// WRITE VIDEO FRAME
// =================================================

bool writeAviFrame(camera_fb_t *fb) {

  if (!videoFile || !fb) {
    return false;
  }

  if (aviIndex.size() >= MAX_VIDEO_FRAMES) {
    videoSegmentLimitReached = true;
    stopRecording();
    return false;
  }

  uint32_t chunkPosition = videoFile.position();

  writeFourCC(videoFile, "00dc");
  writeU32(videoFile, fb->len);

  size_t written = videoFile.write(fb->buf, fb->len);

  if (written != fb->len) {
    Serial.println("SD write error!");
    stopRecording();
    return false;
  }

  if (fb->len & 1) {
    videoFile.write((uint8_t)0);
  }

  AviIndexEntry entry;

  entry.offset = chunkPosition - moviDataStart;
  entry.size = fb->len;

  aviIndex.push_back(entry);

  frameCount++;

  return true;
}

// =================================================
// FINALIZE AVI VIDEO
// =================================================

void stopRecording() {

  if (!recording) {
    return;
  }

  recording = false;

  Serial.println("Stopping video recording...");

  if (videoFile) {

    uint32_t moviEnd = videoFile.position();

    patchU32(
      videoFile,
      moviSizePos,
      moviEnd - (moviSizePos + 4)
    );

    // INDEX CHUNK

    writeFourCC(videoFile, "idx1");

    writeU32(videoFile, aviIndex.size() * 16);

    for (size_t i = 0; i < aviIndex.size(); i++) {

      writeFourCC(videoFile, "00dc");

      writeU32(videoFile, 0x10);
      writeU32(videoFile, aviIndex[i].offset);
      writeU32(videoFile, aviIndex[i].size);
    }

    uint32_t finalSize = videoFile.position();

    // UPDATE FRAME COUNTS

    patchU32(videoFile, avihFramesPos, frameCount);
    patchU32(videoFile, strhFramesPos, frameCount);

    // UPDATE RIFF SIZE

    patchU32(
      videoFile,
      riffSizePos,
      finalSize - 8
    );

    videoFile.flush();
    videoFile.close();

    Serial.print("Video saved: ");
    Serial.println(currentVideoPath);

    Serial.print("Frames: ");
    Serial.println(frameCount);
  }

  aviIndex.clear();

  Serial.println("Recording stopped.");
}

// =================================================
// START VIDEO RECORDING
// =================================================

bool startRecording() {

  if (!sdReady || !cameraReady || recording) {
    return false;
  }

  camera_fb_t *fb = esp_camera_fb_get();

  if (!fb) {
    return false;
  }

  // millis() restarts from zero after a power cycle, so check the SD card
  // before choosing a name to avoid overwriting an older recording.
  String videoBase = "/videos/VIDEO_" + String(millis());
  currentVideoPath = videoBase + ".avi";
  uint16_t fileSuffix = 1;
  while (SD_MMC.exists(currentVideoPath)) {
    currentVideoPath = videoBase + "_" + String(fileSuffix++) + ".avi";
  }

  videoFile = SD_MMC.open(currentVideoPath, FILE_WRITE);

  if (!videoFile) {

    esp_camera_fb_return(fb);

    Serial.println("Cannot create video file!");
    return false;
  }

  frameCount = 0;
  videoSegmentLimitReached = false;
  aviIndex.clear();

  aviIndex.reserve(MAX_VIDEO_FRAMES);

  writeAviHeader(fb->width, fb->height);

  recording = true;
  videoStartTime = millis();

  bool ok = writeAviFrame(fb);

  esp_camera_fb_return(fb);

  if (!ok) {
    stopRecording();
    return false;
  }

  Serial.println("VIDEO RECORDING STARTED!");

  return true;
}

// =================================================
// PERSISTENT SETTINGS HELPERS
// =================================================

framesize_t resolutionToFrameSize(const String &resolution) {
  if (resolution == "QQVGA") return FRAMESIZE_QQVGA;
  if (resolution == "QVGA")  return FRAMESIZE_QVGA;
  if (resolution == "VGA")   return FRAMESIZE_VGA;
  if (resolution == "SVGA")  return FRAMESIZE_SVGA;
  if (resolution == "XGA")   return FRAMESIZE_XGA;
  if (resolution == "HD")    return FRAMESIZE_HD;
  if (resolution == "SXGA")  return FRAMESIZE_SXGA;
  if (resolution == "UXGA")  return FRAMESIZE_UXGA;
  return FRAMESIZE_QVGA;
}

void loadPersistentSettings() {
  preferences.begin("camera", true);
  savedResolution = preferences.getString("resolution", "QVGA");
  savedQuality = preferences.getInt("quality", 10);
  savedBrightness = preferences.getInt("brightness", -1);
  savedContrast = preferences.getInt("contrast", 1);
  savedSaturation = preferences.getInt("saturation", 0);
  savedSharpness = preferences.getInt("sharpness", 0);
  savedHmirror = preferences.getInt("hmirror", 1);
  savedVflip = preferences.getInt("vflip", 1);
  cctvEnabled = preferences.getBool("cctv", true);
  preferences.end();

  // Validate stored values in case NVS contains an old/invalid value.
  if (savedResolution != "QQVGA" && savedResolution != "QVGA" &&
      savedResolution != "VGA" && savedResolution != "SVGA" &&
      savedResolution != "XGA" && savedResolution != "HD" &&
      savedResolution != "SXGA" && savedResolution != "UXGA") {
    savedResolution = "QVGA";
  }
  savedQuality = constrain(savedQuality, 10, 63);
  savedBrightness = constrain(savedBrightness, -2, 2);
  savedContrast = constrain(savedContrast, -2, 2);
  savedSaturation = constrain(savedSaturation, -2, 2);
  savedSharpness = constrain(savedSharpness, -2, 2);
  savedHmirror = savedHmirror ? 1 : 0;
  savedVflip = savedVflip ? 1 : 0;
}

void savePersistentSettings() {
  preferences.begin("camera", false);
  preferences.putString("resolution", savedResolution);
  preferences.putInt("quality", savedQuality);
  preferences.putInt("brightness", savedBrightness);
  preferences.putInt("contrast", savedContrast);
  preferences.putInt("saturation", savedSaturation);
  preferences.putInt("sharpness", savedSharpness);
  preferences.putInt("hmirror", savedHmirror);
  preferences.putInt("vflip", savedVflip);
  preferences.end();
}

bool applyPersistentCameraSettings() {
  if (!cameraReady) return false;
  sensor_t *sensor = esp_camera_sensor_get();
  if (!sensor) return false;
  bool ok = true;
  if (sensor->set_framesize(sensor, resolutionToFrameSize(savedResolution)) != 0) ok = false;
  if (sensor->set_quality(sensor, savedQuality) != 0) ok = false;
  if (sensor->set_brightness(sensor, savedBrightness) != 0) ok = false;
  if (sensor->set_contrast(sensor, savedContrast) != 0) ok = false;
  if (sensor->set_saturation(sensor, savedSaturation) != 0) ok = false;
  if (sensor->set_sharpness(sensor, savedSharpness) != 0) ok = false;
  if (sensor->set_hmirror(sensor, savedHmirror) != 0) ok = false;
  if (sensor->set_vflip(sensor, savedVflip) != 0) ok = false;
  delay(120);
  return ok;
}

